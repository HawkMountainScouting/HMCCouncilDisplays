<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CAP Group 2 SAREX | Weather Operations</title><style>
:root{--navy:#071b38;--blue:#123c72;--red:#c52736;--light:#eaf2fc;--muted:#9bb1cb;--line:#27446b;--green:#70dfaa}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#143968,#06152b 65%);color:#f6f9ff;font:16px system-ui,Segoe UI,Arial,sans-serif}header{background:#07172fe8;border-bottom:4px solid var(--red);padding:20px 3.5%;display:flex;justify-content:space-between;gap:20px;align-items:center}.brand{display:flex;gap:16px;align-items:center}.brand-accent{width:6px;height:65px;flex-shrink:0;border-radius:6px;background:var(--red)}.eyebrow{font-size:12px;letter-spacing:2.4px;color:#c7d7ed;font-weight:800}.brand h1{margin:3px 0;font-size:clamp(22px,3vw,38px);letter-spacing:.5px}.location{color:#b9cbe0;font-size:13px}.clock{text-align:right;font-weight:700;font-variant-numeric:tabular-nums}.clock strong{font-size:clamp(21px,2.6vw,32px);display:block}.clock small{color:#a9bed9}main{padding:22px 3.5%;max-width:1900px;margin:auto}.status{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:16px}.pill{border:1px solid #365982;background:#102c50;padding:8px 13px;border-radius:20px;font-size:12px;color:#d9e8fa}.pill b{color:#83e3b5}.grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:14px}.card{background:linear-gradient(145deg,#112e54,#0a203e);border:1px solid #2c4b74;border-radius:16px;padding:20px;min-width:0;box-shadow:0 12px 24px #0002}.label{color:#a9c3e3;text-transform:uppercase;font-weight:800;font-size:12px;letter-spacing:1.5px}.hero{grid-row:span 2;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(140deg,#174679,#0a1f3c)}.temp{font-size:clamp(75px,10vw,155px);font-weight:800;line-height:1.15;letter-spacing:-8px}.condition{font-size:25px;font-weight:650}.value{font-size:clamp(30px,4vw,56px);font-weight:800;margin:14px 0 3px;font-variant-numeric:tabular-nums}.unit{font-size:17px;color:#b4c8e3}.sub{color:#a9c0db;font-size:13px;margin-top:10px}.wide{grid-column:span 2}.section{font-weight:800;letter-spacing:1.5px;font-size:13px;color:#d6e7fb;text-transform:uppercase;margin:24px 0 12px}.forecast{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}.hour{background:#0d294c;border:1px solid #2a4a70;border-radius:12px;padding:14px 8px;text-align:center}.hour .time{font-size:13px;color:#b5cbe5}.hour .symbol{font-size:26px;margin:9px 0}.hour .degrees{font-size:25px;font-weight:800}.hour .detail{font-size:12px;color:#b7cbe4;margin-top:6px}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.alert{border-left:5px solid #f3b85a}.alert.has{border-left-color:#e44856}.alert-title{font-size:22px;font-weight:800;margin:10px 0}.alert-text{font-size:14px;color:#c8d8ea;line-height:1.5}.footer{color:#90a9c7;font-size:12px;padding:22px 3.5%;line-height:1.6}button{cursor:pointer;background:#c52736;border:0;border-radius:9px;color:white;padding:10px 16px;font-weight:800}.refresh{display:flex;gap:12px;align-items:center}.tiny{font-size:12px;color:#b2c8df}.fail{color:#ffd08a!important}@media(max-width:1100px){.grid{grid-template-columns:repeat(3,1fr)}.hero{grid-column:span 3;grid-row:auto}.forecast{grid-template-columns:repeat(4,1fr)}}@media(max-width:650px){header{align-items:flex-start;flex-direction:column}.clock{text-align:left}.grid{grid-template-columns:repeat(2,1fr)}.hero{grid-column:span 2}.wide{grid-column:span 2}.bottom{grid-template-columns:1fr}.forecast{grid-template-columns:repeat(2,1fr)}.card{padding:16px}.temp{font-size:90px}}
</style></head><body><header><div class="brand"><div class="brand-accent" aria-hidden="true"></div><div><div class="eyebrow">CIVIL AIR PATROL • GROUP 2</div><h1>SAREX WEATHER OPERATIONS</h1><div class="location">CHICKIES ROCK COUNTY PARK · 880 Chickies Hill Rd · Columbia, PA 17512</div></div></div><div class="clock"><strong id="clock">--:--:--</strong><small id="date">Eastern Time</small></div></header><main><div class="status"><div class="refresh"><span class="pill" id="state">● Connecting to weather service</span><span class="tiny" id="updated">Awaiting first update</span></div><button onclick="load()">↻ Refresh now</button></div><section class="grid"><div class="card hero"><div><div class="label">Current conditions · Chickies Rock</div><div class="temp" id="temp">--°</div><div class="condition" id="condition">Loading weather…</div></div><div class="sub" id="feels">Feels like --°F</div></div><div class="card"><div class="label">Wind speed</div><div class="value" id="wind">-- <span class="unit">mph</span></div><div class="sub" id="direction">Direction --</div></div><div class="card"><div class="label">Wind gusts</div><div class="value" id="gust">-- <span class="unit">mph</span></div><div class="sub">Monitor exposed terrain and flight-line operations</div></div><div class="card"><div class="label">Relative humidity</div><div class="value" id="humidity">--%</div><div class="sub">Current modeled conditions</div></div><div class="card"><div class="label">Precipitation</div><div class="value" id="precip">-- <span class="unit">in</span></div><div class="sub">Current 15-minute modeled amount</div></div><div class="card"><div class="label">Cloud cover</div><div class="value" id="cloud">--%</div><div class="sub">Estimated sky coverage</div></div><div class="card"><div class="label">Today's daylight</div><div class="value" id="sunset" style="font-size:35px">--:--</div><div class="sub" id="sunrise">Sunrise --:-- · Sunset</div></div></section><div class="section">Next 8 hours · Hourly outlook</div><section class="forecast" id="hours"></section><section class="bottom"><div class="card alert" id="alertcard"><div class="label">National Weather Service · Active alerts</div><div class="alert-title" id="alerttitle">Checking alerts…</div><div class="alert-text" id="alertbody">NWS alerts for the local area will appear here when available.</div></div><div class="card"><div class="label">Operational weather reminder</div><div class="alert-title">Monitor • Assess • Adjust</div><div class="alert-text">Weather is one input to your SAREX risk assessment. Check official NWS forecasts, brief crews and ground teams, and reassess when conditions change. This dashboard is not an aviation weather briefing and is not a go/no-go authority. For flight operations use approved aviation weather sources and PIC judgment.</div></div></section></main><div class="footer">Weather: Open-Meteo forecast/model data near 40.05157° N, 76.51686° W. Values are not an on-site sensor reading. Alerts: NWS API, when available. Refreshes every 5 minutes; requires internet. Civil Air Patrol-inspired color palette; unofficial operational display, not an official CAP product. Forecasts and conditions may differ from observations at the park.</div><script>
const lat=40.05157,lon=-76.51686,tz='America/New_York';
const $=id=>document.getElementById(id);
const fmt=(t,opts)=>new Intl.DateTimeFormat('en-US',{timeZone:tz,...opts}).format(t);
function clock(){const n=new Date();$('clock').textContent=fmt(n,{hour:'numeric',minute:'2-digit',second:'2-digit',hour12:true});$('date').textContent=fmt(n,{weekday:'long',month:'long',day:'numeric',year:'numeric'})+' · ET'}
clock();setInterval(clock,1000);
function weather(c){if(c===0)return ['Clear sky','☀️'];if(c<=3)return ['Partly cloudy','⛅'];if(c<=48)return ['Fog / haze','🌫️'];if(c<=57)return ['Drizzle','🌦️'];if(c<=67)return ['Rain','🌧️'];if(c<=77)return ['Snow','🌨️'];if(c<=82)return ['Rain showers','🌦️'];if(c<=86)return ['Snow showers','🌨️'];if(c>=95)return ['Thunderstorms','⛈️'];return ['Variable','☁️']}
function val(v,d=0){return v==null||!Number.isFinite(Number(v))?'--':Number(v).toFixed(d)}
function dir(v){return v==null?'--':['N','NE','E','SE','S','SW','W','NW'][Math.round(v/45)%8]}
function localHour(iso){if(!iso)return '--';const hh=Number(iso.slice(11,13));return ((hh+11)%12+1)+(hh<12?' AM':' PM')}
function localClock(iso){if(!iso)return '--';const hh=Number(iso.slice(11,13));return ((hh+11)%12+1)+iso.slice(13,16)+(hh<12?' AM':' PM')}
function currentLocalHour(){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',hourCycle:'h23'}).formatToParts(new Date());const x=Object.fromEntries(parts.map(p=>[p.type,p.value]));return `${x.year}-${x.month}-${x.day}T${x.hour}:00`}
const base='https://api.open-meteo.com/v1/forecast';
const common={latitude:String(lat),longitude:String(lon),timezone:tz,temperature_unit:'fahrenheit',wind_speed_unit:'mph',precipitation_unit:'inch'};
const full={...common,forecast_days:'2',current:'temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m,wind_gusts_10m',hourly:'temperature_2m,precipitation_probability,weather_code,wind_speed_10m,wind_gusts_10m',daily:'sunrise,sunset'};
const basic={...common,current:'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m'};
async function requestWeather(params){const url=base+'?'+new URLSearchParams(params).toString();const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),12000);try{const r=await fetch(url,{cache:'no-store',signal:controller.signal});if(!r.ok){let detail='';try{detail=(await r.json()).reason||''}catch{}throw Error('HTTP '+r.status+(detail?': '+detail:''))}const d=await r.json();if(d.error)throw Error(d.reason||'Weather API error');if(!d.current)throw Error('No current conditions in response');return d}finally{clearTimeout(timer)}}
let busy=false;
async function load(){if(busy)return;busy=true;$('state').textContent='● Updating weather…';$('updated').classList.remove('fail');let ok=false,partial=false;
try{let d;try{d=await requestWeather(full)}catch(first){console.warn('Full weather request failed:',first);try{d=await requestWeather(basic);partial=true}catch(second){throw Error('Full request: '+first.message+'; fallback: '+second.message)}}
const c=d.current;
$('temp').textContent=val(c.temperature_2m)+'°';$('condition').textContent=weather(c.weather_code)[0];$('feels').textContent='Feels like '+val(c.apparent_temperature)+'°F';
$('wind').innerHTML=val(c.wind_speed_10m)+' <span class="unit">mph</span>';$('direction').textContent='From '+dir(c.wind_direction_10m)+' · '+val(c.wind_direction_10m)+'°';
$('gust').innerHTML=val(c.wind_gusts_10m)+' <span class="unit">mph</span>';$('humidity').textContent=val(c.relative_humidity_2m)+'%';
$('precip').innerHTML=val(c.precipitation,2)+' <span class="unit">in</span>';$('cloud').textContent=val(c.cloud_cover)+'%';
if(d.daily?.sunrise?.[0]){$('sunrise').textContent='Sunrise '+localClock(d.daily.sunrise[0]);$('sunset').textContent=localClock(d.daily.sunset[0])}else{$('sunrise').textContent='Daylight data unavailable';$('sunset').textContent='--'}
if(d.hourly?.time?.length){const current=currentLocalHour();let i=d.hourly.time.findIndex(t=>t>=current);if(i<0)i=0;$('hours').innerHTML=d.hourly.time.slice(i,i+8).map((t,j)=>{const k=i+j;return `<div class="hour"><div class="time">${localHour(t)}</div><div class="symbol">${weather(d.hourly.weather_code[k])[1]}</div><div class="degrees">${val(d.hourly.temperature_2m[k])}°</div><div class="detail">Precip ${val(d.hourly.precipitation_probability[k])}%</div><div class="detail">Wind ${val(d.hourly.wind_speed_10m[k])} mph</div><div class="detail">Gust ${val(d.hourly.wind_gusts_10m[k])} mph</div></div>`}).join('')}else{$('hours').innerHTML='<div class="hour" style="grid-column:1/-1">Hourly forecast temporarily unavailable; current conditions shown above.</div>'}
$('updated').textContent=(partial?'Limited data (fallback)':'Weather updated')+' · '+fmt(new Date(),{hour:'numeric',minute:'2-digit',hour12:true})+' ET';ok=true;
}catch(e){$('updated').textContent='Weather unavailable: '+e.message;$('updated').classList.add('fail');$('condition').textContent='Weather data unavailable';$('hours').innerHTML='<div class="hour" style="grid-column:1/-1">Unable to load forecast. Check your connection and try Refresh now.</div>';console.error('Weather dashboard:',e)}
$('state').innerHTML=ok?(partial?'● <b>LIMITED WEATHER DATA</b>':'● <b>LIVE DATA CONNECTED</b>'):'● <span class="fail">DATA UNAVAILABLE</span>';
try{const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),10000);let r;try{r=await fetch('https://api.weather.gov/alerts/active?point='+lat+','+lon,{headers:{Accept:'application/geo+json'},signal:controller.signal})}finally{clearTimeout(timer)}if(!r.ok)throw Error('NWS HTTP '+r.status);const d=await r.json(),a=d.features||[];if(a.length){$('alertcard').classList.add('has');$('alerttitle').textContent=a.length+' active alert'+(a.length===1?'':'s');$('alertbody').textContent=a.map(x=>(x.properties?.event||'Alert')+': '+(x.properties?.headline||'See weather.gov')).join(' • ')}else{$('alertcard').classList.remove('has');$('alerttitle').textContent='No active alerts returned';$('alertbody').textContent='No active NWS alerts returned for this point. Continue monitoring official sources.'}}catch(e){$('alertcard').classList.remove('has');$('alerttitle').textContent='Alert feed unavailable';$('alertbody').textContent='Unable to verify active NWS alerts. Check weather.gov directly.';console.warn('NWS alert request:',e)}finally{busy=false}}
load();setInterval(load,300000);
</script></body></html>
